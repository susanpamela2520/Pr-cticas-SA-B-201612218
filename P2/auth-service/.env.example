AUTH_PORT=3000

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# --- JWT ---
# Clave secreta para firmar los tokens. En un entorno real, generar una
# propia y NUNCA subirla a un repositorio público.
JWT_SECRET=cambia-esta-clave-por-una-propia-y-larga
# Tiempo de vida del access token, en segundos. 60 = 1 minuto (corto a
# propósito para poder DEMOSTRAR la renovación automática fácilmente).
JWT_TTL_SEGUNDOS=60
# Período de gracia tras la expiración durante el cual el token se
# renueva automáticamente en vez de forzar un nuevo login, en segundos.
JWT_RENOVACION_GRACIA_SEGUNDOS=120

# --- Cifrado AES-256-GCM de campos sensibles ---
# Debe ser exactamente 64 caracteres hexadecimales (32 bytes = 256 bits).
# Generar uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_KEY_HEX=3b5331c626906b21bb728d8f6eb07ecedce63949110948f34920c525c9188e07

# Secreto para el HMAC del correo (usado solo para poder buscarlo/indexarlo).
CORREO_HASH_SECRET=otro-secreto-distinto-para-el-hash-del-correo

# --- Microservicio de autorización ---
AUTHZ_SERVICE_URL=http://localhost:4000
AUTHZ_MAX_RETRIES=3
AUTHZ_BACKOFF_BASE_MS=300
AUTHZ_TIMEOUT_MS=2000
